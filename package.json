{
  "name": "magpie-memory-hub",
  "version": "6.44.0",
  "description": "Magpie \u7f51\u5173\u7684\u900f\u660e\u8bb0\u5fc6\u5c42\uff1a\u81ea\u52a8\u63d0\u70bc\u4e0a\u4e0b\u6587\u5b58\u5165 NoCodeBackend\uff0c\u5411 agent \u63d0\u4f9b\u8bb0\u5fc6\u68c0\u7d22\u4e0e R2 \u6587\u4ef6\u5b58\u50a8 MCP \u5de5\u5177\uff1b\u5185\u7f6e\u5e42\u7b49\u7684\u6570\u636e\u5e93\u521d\u59cb\u5316\u4e0e\u6e05\u7a7a\u3002",
  "type": "module",
  "main": "./tools.js",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "memory",
    "mcp",
    "nocodebackend",
    "headroom"
  ],
  "author": "otaku-say",
  "license": "MIT",
  "files": [
    "*.js",
    "settings.html",
    "settings.css",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "magpie": {
    "hooks": "./gateway_harvest.hooks.js",
    "middleware": "./memory.middleware.js",
    "icon": "./icon.svg",
    "maxConcurrency": 4,
    "page": {
      "title": "\u8bb0\u5fc6\u4e2d\u67a2\u8bbe\u7f6e",
      "file": "./settings.html",
      "icon": "./icon.svg",
      "titles": {
        "zh": "\u8bb0\u5fc6\u4e2d\u67a2\u8bbe\u7f6e",
        "zh-TW": "\u8a18\u61b6\u4e2d\u6a1e\u8a2d\u5b9a",
        "ja": "\u30e1\u30e2\u30ea\u30cf\u30d6\u8a2d\u5b9a",
        "de": "Memory-Hub-Einstellungen"
      }
    },
    "options": {
      "gatewayTimeoutMs": 8000,
      "disabled": false,
      "ncb_instance": "memory",
      "ncb_secret": "",
      "inline_extract": true,
      "max_inject_count": 5,
      "max_budget_chars": 2048,
      "min_confidence": 0.6,
      "memories": [],
      "ccr_cards": false,
      "inject_principles": true,
      "max_principles": 2,
      "mcp_key": "",
      "auto_init": false,
      "auto_harvest": false,
      "on_exist": "reuse",
      "extract_model": "",
      "classify_model": "",
      "audit_model": "",
      "dedup_schedule": "off",
      "dedup_time": "02:00",
      "dedup_weekday": 1,
      "dedup_day": 1,
      "dedup_batch_size": 50,
      "classify_endpoint": "auto",
      "search_rewrite": true,
      "dedup_fetch_limit": 200,
      "search_rerank": true,
      "harvest_max_per_min": 20,
      "harvest_max_total": 2000,
      "audit_max_batches": 2,
      "audit_chunk_size": 40
    },
    "permissions": [
      "usage:summary",
      "providers:list"
    ]
  }
}
