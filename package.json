{
  "name": "magpie-memory-hub",
  "version": "6.0.0",
  "description": "Magpie 网关的透明记忆层：自动提炼上下文存入 NoCodeBackend，向 agent 提供记忆检索与 R2 文件存储 MCP 工具；内置幂等的数据库初始化与清空。",
  "type": "module",
  "main": "./tools.js",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "memory",
    "mcp",
    "nocodebackend",
    "headroom"
  ],
  "author": "otaku-say",
  "license": "MIT",
  "magpie": {
    "middleware": "./memory.middleware.js",
    "icon": "./icon.svg",
    "page": {
      "title": "记忆中枢设置",
      "file": "./settings.html",
      "icon": "./icon.svg"
    },
    "options": {
      "disabled": false,
      "ncb_instance": "41694_agent_memory",
      "ncb_secret": "",
      "magpie_base_url": "http://127.0.0.1:8000/v1",
      "magpie_api_key": "",
      "extractor_model": "",
      "clef_model": "",
      "inline_extract": true,
      "max_inject_count": 5,
      "max_budget_chars": 2048,
      "min_confidence": 0.6,
      "memories": [],
      "compress": true,
      "compress_max_chars": 3000,
      "compress_min_chars": 1200,
      "ccr_cards": true,
      "inject_principles": true,
      "max_principles": 2,
      "clef_mode": "rule",
      "compress_engine": "auto",
      "cross_turn_dedup": true,
      "mcp_key": "",
      "storage_public_url": "",
      "auto_init": false
    }
  }
}
