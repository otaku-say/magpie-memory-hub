{
  "name": "magpie-memory-hub",
  "version": "2.0.0",
  "description": "Transparent long-term memory gateway for Magpie. Auto-extracts knowledge from conversations and injects relevant memories into prompts.",
  "type": "module",
  "main": "./memory.middleware.js",
  "keywords": ["magpie", "magpie-plugin", "middleware", "memory", "nocodebackend"],
  "author": "otaku-say",
  "license": "MIT",
  "magpie": {
    "middleware": "./memory.middleware.js",
    "icon": "icon.svg",
    "page": {
      "title": "记忆中枢设置",
      "file": "./settings.html",
      "icon": "./icon.svg"
    },
    "options": {
      "disabled": false,
      "max_inject_count": 5,
      "max_budget_chars": 2048,
      "extractor_model": "",
      "ncb_instance": "41694_agent_memory",
      "mcp_path": "/agent_memory",
      "memories": []
    }
  }
}
