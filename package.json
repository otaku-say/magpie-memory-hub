{
  "name": "magpie-memory-hub",
  "version": "7.0.0",
  "description": "Magpie 网关的透明记忆层：自动提炼上下文存入 NoCodeBackend，向 agent 提供记忆检索与 R2 文件存储 MCP 工具；内置幂等的数据库初始化与清空。",
  "type": "module",
  "main": "./tools.js",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "memory",
    "mcp",
    "nocodebackend",
    "headroom"
  ],
  "author": "otaku-say",
  "license": "MIT",
  "files": [
    "tools.js",
    "memory.middleware.js",
    "gateway_harvest.hooks.js",
    "src/**",
    "settings.html",
    "icon.svg",
    "README.md",
    "LICENSE",
    "memory-cli.js",
    "RELEASE-v7.0.0.md"
  ],
  "magpie": {
    "hooks": "./gateway_harvest.hooks.js",
    "middleware": "./memory.middleware.js",
    "icon": "./icon.svg",
    "maxConcurrency": 4,
    "page": {
      "title": "记忆中枢",
      "file": "./settings.html",
      "icon": "./icon.svg",
      "titles": {
        "zh": "记忆中枢",
        "zh-TW": "記憶中樞",
        "ja": "メモリハブ",
        "de": "Memory Hub"
      }
    },
    "options": {
      "gatewayTimeoutMs": 8000,
      "disabled": false,
      "ncb_instance": "memory",
      "ncb_secret": "",
      "inline_extract": true,
      "capability_gate": "auto",
      "env_scope_strict": true,
      "guide_on_no_tools": false,
      "client_profiles": "",
      "cli_channel": "",
      "caps_telemetry": true,
      "max_inject_count": 5,
      "max_budget_chars": 2048,
      "min_confidence": 0.6,
      "memories": [],
      "ccr_cards": false,
      "inject_principles": true,
      "max_principles": 2,
      "mcp_key": "",
      "auto_init": false,
      "auto_harvest": false,
      "on_exist": "reuse",
      "extract_model": "",
      "classify_model": "",
      "audit_model": "",
      "dedup_schedule": "off",
      "dedup_time": "02:00",
      "dedup_weekday": 1,
      "dedup_day": 1,
      "dedup_batch_size": 50,
      "classify_endpoint": "auto",
      "search_rewrite": true,
      "dedup_fetch_limit": 200,
      "search_rerank": true,
      "harvest_max_per_min": 20,
      "harvest_max_total": 2000,
      "audit_max_batches": 2,
      "audit_chunk_size": 40,
      "model_timeout_sec": 30,
      "rerank_timeout_sec": 15,
      "rerank_max_candidates": 10,
      "log_level": "off"
    },
    "permissions": [
      "usage:summary",
      "providers:list"
    ]
  }
}
