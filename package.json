{
  "name": "magpie-memory-hub",
  "version": "6.21.0",
  "description": "Magpie 网关的透明记忆层：自动提炼上下文存入 NoCodeBackend，向 agent 提供记忆检索与 R2 文件存储 MCP 工具；内置幂等的数据库初始化与清空。",
  "type": "module",
  "main": "./tools.js",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "memory",
    "mcp",
    "nocodebackend",
    "headroom"
  ],
  "author": "otaku-say",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "compress.js",
    "db_tools.js",
    "gateway_harvest.hooks.js",
    "gateway_harvest.js",
    "harvest.py",
    "icon.svg",
    "local_state.js",
    "mcp_client.js",
    "memory.middleware.js",
    "model_budget.js",
    "ncb_mcp.js",
    "online_models.js",
    "page_actions.js",
    "r2.js",
    "schema.js",
    "semantic_dedup.js",
    "settings.css",
    "settings.html",
    "settings.js",
    "tools.js"
  ],
  "magpie": {
    "hooks": "./gateway_harvest.hooks.js",
    "middleware": "./memory.middleware.js",
    "icon": "./icon.svg",
    "maxConcurrency": 4,
    "page": {
      "title": "记忆中枢设置",
      "file": "./settings.html",
      "icon": "./icon.svg"
    },
    "options": {
      "gatewayTimeoutMs": 8000,
      "disabled": false,
      "ncb_instance": "memory",
      "ncb_secret": "",
      "inline_extract": true,
      "max_inject_count": 5,
      "max_budget_chars": 2048,
      "min_confidence": 0.6,
      "memories": [],
      "compress": false,
      "compress_max_chars": 3000,
      "compress_min_chars": 1200,
      "ccr_cards": true,
      "inject_principles": true,
      "max_principles": 2,
      "cross_turn_dedup": true,
      "log_template_dedup": true,
      "mcp_key": "",
      "auto_init": false,
      "auto_harvest": false,
      "on_exist": "reuse",
      "extract_model": "",
      "classify_model": "",
      "classify_endpoint": "auto",
      "search_rewrite": true
    }
  }
}
